import tools.vitruv.framework.vsum.constraints.ConstraintValidationResult;
import tools.vitruv.framework.vsum.constraints.InvalidConstraintException;
</#if>
import tools.vitruv.framework.vsum.internal.InternalVirtualModel;

/**
 * Generated by the Methodologist setup service. Hosts the VSUM in a Vitruvius server.
 *
 * <p>Usage: {@code java -jar <jar> [port]}. Type {@code quit} to stop the server.
 */
public class [=vsumMainClass] {

  /** Storage folder of the VSUM. */
  static final Path STORAGE_FOLDER = Path.of("vsumexample").toAbsolutePath();

  /** Classpath resources containing the VitruvOCL constraints of this VSUM. */
  static final List<String> CONSTRAINT_RESOURCES = List.of(<#list constraintResources as resource>
      "[=resource]"<#sep>,</#sep></#list>);

  public static void main(String[] args) throws IOException, InterruptedException {
    VitruvServer server =
        args.length > 0
            ? new VitruvServer([=vsumMainClass]::createVirtualModel, Integer.parseInt(args[0]))
            : new VitruvServer([=vsumMainClass]::createVirtualModel);
    server.start();
    Runtime.getRuntime().addShutdownHook(new Thread(server::stop));
    System.out.println("VSUM server started. Type 'quit' to stop it.");

    try (Scanner scanner = new Scanner(System.in)) {
      while (scanner.hasNextLine()) {
        if ("quit".equalsIgnoreCase(scanner.nextLine().trim())) {
          System.exit(0);
        }
      }
    }
    // stdin is closed (e.g. when running detached): keep serving until the process is stopped
    Thread.currentThread().join();
  }

  private static InternalVirtualModel createVirtualModel() {
    try {
      return createVirtualModel(STORAGE_FOLDER);
    } catch (IOException e) {
      throw new UncheckedIOException(e);
    }
  }

  /**
   * Creates the VSUM, or loads it if the storage folder already contains one.
   *
   * @param storageFolder folder in which the VSUM persists its models
   * @return the initialized VSUM
   * @throws IOException when the VSUM cannot be initialized
   */
  public static InternalVirtualModel createVirtualModel(Path storageFolder) throws IOException {
    registerMetamodels();
    InternalVirtualModel vsum =
        new VirtualModelBuilder()
            .withStorageFolder(storageFolder)
            .withUserInteractorForResultProvider(
                new TestUserInteraction.ResultProvider(new TestUserInteraction()))
            .withChangePropagationSpecifications(createChangePropagationSpecifications())
            .withViewTypes(createViewTypes())
<#if constraintResources?has_content>
            // the Vitruv server lists, validates and manages the constraints via REST
            .withConstraintChecker(createConstraintChecker())
            .withConstraintValidationAfterPropagation(true)
</#if>
            .buildAndInitialize();
<#if constraintResources?has_content>
    vsum.addConstraintValidationListener(
        (report, trigger) -> {
          if (trigger == Trigger.PROPAGATION) {
            reportViolations(report);
          }
        });
</#if>
    return vsum;
  }

  /**
   * Registers the metamodels before any persisted model is loaded, and the XMI serialization used
   * for model files of any extension.
   */
  static void registerMetamodels() {
    Resource.Factory.Registry.INSTANCE
        .getExtensionToFactoryMap()
        .putIfAbsent("*", new XMIResourceFactoryImpl());
    tools.vitruv.dsls.reactions.runtime.correspondence.CorrespondencePackage.eINSTANCE.eClass();
<#list packageInterfaces as packageInterface>
    [=packageInterface].eINSTANCE.eClass();
</#list>
  }

  static List<ChangePropagationSpecification> createChangePropagationSpecifications() {
    List<ChangePropagationSpecification> specifications = new ArrayList<>();
<#list changePropagationSpecifications as specification>
    specifications.add(new [=specification]());
</#list>
    return specifications;
  }

  static Collection<ViewType<?>> createViewTypes() {
    List<ViewType<?>> viewTypes = new ArrayList<>();
<#list metamodels as metamodel>
    viewTypes.add(ViewTypeFactory.createIdentityMappingViewType("[=metamodel.name]"));
</#list>
    return viewTypes;
  }
<#if constraintResources?has_content>

  /**
   * Creates the checker of the VitruvOCL constraints of this VSUM.
   *
   * @return the checker of all constraint resources
   * @throws IllegalArgumentException if a constraint resource cannot be parsed, described as by
   *     {@link #describeFailures}
   */
  static VitruvOclConstraintChecker createConstraintChecker() {
    for (String resource : CONSTRAINT_RESOURCES) {
      try {
        VitruvOclConstraintChecker.fromClasspath(resource);
      } catch (InvalidConstraintException e) {
        List<String> lines = readResource(resource).lines().toList();
        Map<String, List<String>> errors = new LinkedHashMap<>();
        e.getDiagnostics()
            .forEach(
                diagnostic ->
                    errors
                        .computeIfAbsent(
                            diagnostic.line() >= 1 && diagnostic.line() <= lines.size()
                                ? lines.get(diagnostic.line() - 1).strip()
                                : resource,
                            line -> new ArrayList<>())
                        .add(
                            diagnostic.line()
                                + ":"
                                + diagnostic.column()
                                + " "
                                + diagnostic.message()));
        throw new IllegalArgumentException(describeFailures(resource, errors), e);
      }
    }
    return VitruvOclConstraintChecker.fromClasspath(CONSTRAINT_RESOURCES.toArray(String[]::new));
  }

  /**
   * Describes constraints of a resource that cannot be evaluated, in the form the setup service
   * attributes to the uploaded constraint file.
   *
   * @param resource the classpath resource of the constraints
   * @param errors the errors per constraint (its source or the faulty line)
   * @return the description
   */
  static String describeFailures(String resource, Map<String, List<String>> errors) {
    StringBuilder description =
        new StringBuilder("Constraints in " + resource + " cannot be evaluated:\n");
    errors.forEach(
        (constraint, constraintErrors) -> {
          description.append("- ").append(constraint.replaceAll("\\s+", " ")).append('\n');
          constraintErrors.forEach(error -> description.append("    ").append(error).append('\n'));
        });
    return description.toString();
  }

  private static String readResource(String resource) {
    try (InputStream input =
        [=vsumMainClass].class.getClassLoader().getResourceAsStream(resource)) {
      return input == null ? "" : new String(input.readAllBytes(), StandardCharsets.UTF_8);
    } catch (IOException e) {
      throw new UncheckedIOException(e);
    }
  }

  /**
   * Reports the constraints violated after a change propagation. The Vitruv server offers the
   * full results, including the violating elements, under {@code /vsum/constraints/validate}.
   *
   * @param report the validation result of all constraints
   */
  static void reportViolations(ConstraintValidationReport report) {
    for (ConstraintValidationResult result : report.getUnsatisfiedResults()) {
      String id = result.descriptor().id();
      result
          .violations()
          .forEach(
              violation ->
                  System.err.println("[OCL VIOLATION] " + id + ": " + violation.message()));
      result.errors().forEach(error -> System.err.println("[OCL ERROR] " + id + ": " + error));
    }
  }
</#if>
}
