/**
 * Generated by the Methodologist setup service. Hosts the VSUM in a Vitruvius server.
 *
 * <p>Usage: {@code java -jar <jar> [port]}. Type {@code quit} to stop the server.
 */
public class [=vsumMainClass] {

  /** Storage folder of the VSUM. */
  static final Path STORAGE_FOLDER = Path.of("vsumexample").toAbsolutePath();

  /** Classpath resources containing the VitruvOCL constraints of this VSUM. */
  static final List<String> CONSTRAINT_RESOURCES = List.of(<#list constraintResources as resource>
      "[=resource]"<#sep>,</#sep></#list>);

  public static void main(String[] args) throws IOException, InterruptedException {
    VitruvServer server =
        args.length > 0
            ? new VitruvServer([=vsumMainClass]::createVirtualModel, Integer.parseInt(args[0]))
            : new VitruvServer([=vsumMainClass]::createVirtualModel);
    server.start();
    Runtime.getRuntime().addShutdownHook(new Thread(server::stop));
    System.out.println("VSUM server started. Type 'quit' to stop it.");

    try (Scanner scanner = new Scanner(System.in)) {
      while (scanner.hasNextLine()) {
        if ("quit".equalsIgnoreCase(scanner.nextLine().trim())) {
          System.exit(0);
        }
      }
    }
    // stdin is closed (e.g. when running detached): keep serving until the process is stopped
    Thread.currentThread().join();
  }

  private static InternalVirtualModel createVirtualModel() {
    try {
      return createVirtualModel(STORAGE_FOLDER);
    } catch (IOException e) {
      throw new UncheckedIOException(e);
    }
  }

  /**
   * Creates the VSUM, or loads it if the storage folder already contains one.
   *
   * @param storageFolder folder in which the VSUM persists its models
   * @return the initialized VSUM
   * @throws IOException when the VSUM cannot be initialized
   */
  public static InternalVirtualModel createVirtualModel(Path storageFolder) throws IOException {
    registerMetamodels();
    InternalVirtualModel vsum =
        new VirtualModelBuilder()
            .withStorageFolder(storageFolder)
            .withUserInteractorForResultProvider(
                new TestUserInteraction.ResultProvider(new TestUserInteraction()))
            .withChangePropagationSpecifications(createChangePropagationSpecifications())
            .withViewTypes(createViewTypes())
            .buildAndInitialize();
<#if constraintResources?has_content>
    registerConstraintEvaluation(vsum);
</#if>
    return vsum;
  }

  /**
   * Registers the metamodels before any persisted model is loaded, and the XMI serialization used
   * for model files of any extension.
   */
  static void registerMetamodels() {
    Resource.Factory.Registry.INSTANCE
        .getExtensionToFactoryMap()
        .putIfAbsent("*", new XMIResourceFactoryImpl());
    tools.vitruv.dsls.reactions.runtime.correspondence.CorrespondencePackage.eINSTANCE.eClass();
<#list packageInterfaces as packageInterface>
    [=packageInterface].eINSTANCE.eClass();
</#list>
  }

  static List<ChangePropagationSpecification> createChangePropagationSpecifications() {
    List<ChangePropagationSpecification> specifications = new ArrayList<>();
<#list changePropagationSpecifications as specification>
    specifications.add(new [=specification]());
</#list>
    return specifications;
  }

  static Collection<ViewType<?>> createViewTypes() {
    List<ViewType<?>> viewTypes = new ArrayList<>();
<#list metamodels as metamodel>
    viewTypes.add(ViewTypeFactory.createIdentityMappingViewType("[=metamodel.name]"));
</#list>
    return viewTypes;
  }
<#if constraintResources?has_content>

  /** Evaluates all constraints after every change propagation and reports violations. */
  static void registerConstraintEvaluation(InternalVirtualModel vsum) {
    VitruvOCL.registerVSUM(vsum);
    vsum.addChangePropagationListener(
        new ChangePropagationListener() {
          @Override
          public void startedChangePropagation(VitruviusChange<Uuid> changeToPropagate) {
            // constraints are evaluated once all reactions have been executed
          }

          @Override
          public void finishedChangePropagation(Iterable<PropagatedChange> propagatedChanges) {
            for (String resource : CONSTRAINT_RESOURCES) {
              BatchValidationResult result = evaluateConstraints(resource);
              result
                  .getViolatedConstraints()
                  .forEach(
                      violation ->
                          System.err.println(
                              "[OCL VIOLATION] "
                                  + violation.getConstraint()
                                  + ": "
                                  + violation.getWarningsSummary()));
              if (!result.allSucceeded()) {
                System.err.println("[OCL ERROR] " + resource + ":\n" + describeFailures(result));
              }
            }
          }
        });
  }

  /**
   * Evaluates the constraints of a classpath resource against the registered VSUM.
   *
   * @param resource classpath resource of an {@code .ocl} file
   * @return the evaluation result
   */
  static BatchValidationResult evaluateConstraints(String resource) {
    try {
      Path file = Files.createTempFile("constraints", ".ocl");
      try (InputStream input =
          [=vsumMainClass].class.getClassLoader().getResourceAsStream(resource)) {
        if (input == null) {
          throw new IllegalStateException("Constraint resource not found: " + resource);
        }
        Files.copy(input, file, StandardCopyOption.REPLACE_EXISTING);
        return VitruvOCL.evaluateConstraints(file);
      } finally {
        Files.deleteIfExists(file);
      }
    } catch (IOException e) {
      throw new UncheckedIOException(e);
    }
  }

  /**
   * Describes the constraints that could not be compiled or evaluated.
   *
   * @param result an evaluation result
   * @return one entry per failed constraint with its errors
   */
  static String describeFailures(BatchValidationResult result) {
    StringBuilder description = new StringBuilder();
    for (ConstraintResult failure : result.getFailedConstraints()) {
      description
          .append("- ")
          .append(failure.getConstraint().strip().replaceAll("\\s+", " "))
          .append('\n');
      failure
          .getCompilerErrors()
          .forEach(
              error ->
                  description.append(
                      String.format(
                          "    %d:%d %s%n", error.getLine(), error.getColumn(), error.getMessage())));
      failure
          .getFileErrors()
          .forEach(error -> description.append("    ").append(error.getMessage()).append('\n'));
    }
    return description.toString();
  }
</#if>
}
