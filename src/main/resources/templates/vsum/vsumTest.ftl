package [=vsumPackage];

import java.io.IOException;
import java.nio.file.Path;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.io.TempDir;
<#if constraintResources?has_content>
import org.junit.jupiter.api.Assertions;
import tools.vitruv.dsls.vitruvocl.pipeline.BatchValidationResult;
import tools.vitruv.framework.vsum.internal.InternalVirtualModel;
</#if>

/**
 * Generated by the Methodologist setup service. Smoke test that runs during the build to check
 * that the VSUM can actually be created from the metamodels, reactions, and constraints.
 */
class [=vsumMainClass]Test {

  @Test
  void virtualModelCanBeCreatedAndReloaded(@TempDir Path storageFolder) throws IOException {
    [=vsumMainClass].createVirtualModel(storageFolder).dispose();
    [=vsumMainClass].createVirtualModel(storageFolder).dispose();
  }
<#if constraintResources?has_content>

  @Test
  void constraintsCanBeEvaluated(@TempDir Path storageFolder) throws IOException {
    InternalVirtualModel vsum = [=vsumMainClass].createVirtualModel(storageFolder);
    try {
      for (String resource : [=vsumMainClass].CONSTRAINT_RESOURCES) {
        BatchValidationResult result = [=vsumMainClass].evaluateConstraints(resource);
        Assertions.assertTrue(
            result.allSucceeded(),
            () ->
                "Constraints in "
                    + resource
                    + " cannot be evaluated:\n"
                    + [=vsumMainClass].describeFailures(result));
      }
    } finally {
      vsum.dispose();
    }
  }
</#if>
}
